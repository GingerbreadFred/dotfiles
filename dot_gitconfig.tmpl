{{ if .work -}}
[user]
	name = {{ .workName }}
	email = {{ .workEmail }}
# Commits to this public dotfiles repo keep the personal identity.
[includeIf "gitdir:{{ .chezmoi.sourceDir }}/"]
	path = ~/.config/git/personal-identity
{{ else -}}
{{ template "personal-identity" . -}}
{{ end -}}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[push]
	autoSetupRemote = true
[core]
	editor = nvim
[merge]
	tool = vimdiff
[mergetool "vimdiff"]
	cmd = nvim -d $LOCAL $REMOTE $MERGED
