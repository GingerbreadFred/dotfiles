if [ -d /opt/homebrew/opt/llvm/bin ]; then
  export PATH="/opt/homebrew/opt/llvm/bin:$PATH"
fi
export PATH="$HOME/.local/bin:$PATH"
if [ "$TERM_PROGRAM" != "Apple_Terminal" ] && command -v oh-my-posh >/dev/null && command -v brew >/dev/null; then
  eval "$(oh-my-posh init zsh --config $(brew --prefix oh-my-posh)/themes/catppuccin_mocha.omp.json)"
fi

autoload -Uz compinit && compinit
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

export EDITOR="nvim"
export VISUAL="nvim"

# Open Plannotator in a new Firefox window rather than a tab (macOS launcher only)
if [ -x "$HOME/.plannotator/firefox-new-window.sh" ]; then
  export PLANNOTATOR_BROWSER="$HOME/.plannotator/firefox-new-window.sh"
fi

if command -v gls >/dev/null; then
  alias ls='gls -alGh --classify --group-directories-first'
elif ls --version >/dev/null 2>&1; then
  alias ls='ls -alGh --classify --group-directories-first' # GNU ls (Linux)
else
  alias ls='ls -alGhF' # BSD ls (macOS without coreutils)
fi
alias ll='ls'

git-prune-branches() {
  git fetch -p
  local branches=$(git branch -vv | grep ': gone]' | awk '{print $1}')
  if [[ -z "$branches" ]]; then
    echo "No branches with detached remotes found."
    return
  fi
  echo "Deleting branches with gone remotes:"
  echo "$branches"
  echo "$branches" | xargs git branch -D
}

# Unity CLI
if [ -f "$HOME/.unity/env" ]; then
  . "$HOME/.unity/env"
fi
