{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -eu

# Rendered differently once Homebrew is on PATH, so chezmoi re-runs this:
# brew {{ if lookPath "brew" }}found{{ else }}missing{{ end }}

if ! command -v brew &>/dev/null; then
    echo "Homebrew not found; install it, then run: brew install --cask font-fira-code-nerd-font"
    exit 0
fi

if ! brew list --cask font-fira-code-nerd-font &>/dev/null; then
    brew install --cask font-fira-code-nerd-font
fi
{{ end -}}
